# Copy to `.env` and fill in. `.env` is gitignored; this file is not, and must
# never carry a real value.
#
# Used by the live adapter suites (`just teamcity-live`), which are `#[ignore]`d
# so `just check` stays offline and docker-free.

# A TeamCity server. JetBrains' public instance is guest-readable and needs no
# credential at all, which is why the value below is a known-good default
# rather than a blank: `/guestAuth` is a real path prefix on that server, and
# `knobas-http` builds URLs by concatenation precisely so a prefix survives.
#
# That server is NOT ours. The suite is read-only and must stay that way --
# unlike `just gitea-live`, which opens a real pull request against a container
# we own.
KNOBAS_TEAMCITY_URL=https://teamcity.jetbrains.com/guestAuth

# Optional. Leave empty for a `/guestAuth` URL: the path prefix authenticates
# the request and the header is ignored, and the suite then passes a
# placeholder secret because the adapter refuses a missing one outright. Set it
# for a server that does need a credential -- a TeamCity access token (2019.1+),
# sent as a Bearer token -- where an empty value fails loudly as Unauthorized,
# which is the honest outcome there.
KNOBAS_TEAMCITY_TOKEN=
