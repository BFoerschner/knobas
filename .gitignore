.worktrees/
target/
node_modules/
# The fixture repository's vendored folder, which the files pass must leave
# out (the everything-search decisions, D16): checked in, as a forge holds it.
!fixtures/tidewater/files/tidewater/payout-service/node_modules/
.DS_Store
!.claude/agents
dist
# Written by tauri-build on every compile: the permission schemas for the
# capability files. Regenerated, never edited.
crates/knobas-app/gen/
# The PostgreSQL archive a release build carries, staged by
# `scripts/fetch-postgres.sh` (54 MB on Windows): a build input, pinned by
# `crates/knobas-app/postgresql/archives.sha256`, never committed.
crates/knobas-app/postgresql/*.tar.gz
# The decompiler jar a build carries, staged by `scripts/fetch-vineflower.sh`
# (1.6 MB): a build input, pinned by `crates/knobas-app/decompiler/vineflower.sha256`.
crates/knobas-app/decompiler/*.jar

# Local credentials for the live adapter suites (`just *-live`). Never
# committed: a token in git history is a token to rotate, not a token to
# delete, and `.env` is the one file in the tree that is meant to hold one.
# `.env.example` records the variable names, and their known-good public
# values, without a secret.
.env
.env.*
!.env.example

# Python bytecode, written when a script under scripts/ is imported.
__pycache__/

# The ticket loop's local state: the in-flight ledger (`.claude/loop/`; the
# tracked stages.sh stays tracked), the per-machine permission overrides and
# the scheduler's lock. A clone on another machine has none of them tracked.
.claude/loop/
.claude/settings.local.json
.claude/scheduled_tasks.lock
