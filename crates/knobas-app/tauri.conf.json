{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "knobas",
  "version": "3.2.6",
  "identifier": "dev.knobas.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "cwd": "../../app",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../../app",
      "script": "npm run build"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "knobas",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 600,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "3.2.6"
      }
    }
  }
}
