# docs/how-it-works.md's system map. `just readme-diagrams` renders it in both themes.
#
# Read down the left for sync and reads, up the right for writes. Amber is the
# only route that changes anything at a source.
#
# Every group has a fixed place (`top`, `left`), which TALA honours and routes
# around. Left to itself TALA folded the groups into a square with edges looping
# round the outside, and moved the whole picture after a small edit. The picture
# is tall rather than wide so its text stays readable in GitHub's column.

classes: {
  write: {
    style: {
      stroke: "#D97706"
      stroke-width: 2
      font-color: "#D97706"
    }
  }
  write-box: {
    style: {
      stroke: "#D97706"
      stroke-width: 2
    }
  }
  optional: {
    style.stroke-dash: 4
  }
}

sources: Your sources {
  top: 0
  left: 110
  grid-columns: 3
  jira: Jira Data Center
  confluence: Confluence Data Center
  gitea: Gitea or Forgejo
  teamcity: TeamCity
  kuma: Uptime Kuma
  other: Any other source {
    class: optional
  }
}

keychain: OS keychain {
  top: 440
  left: 0
}

adapters: Adapters {
  top: 380
  left: 260
  grid-columns: 2
  builtin: "Built-in\none Rust crate per source"
  external: "External\na sandboxed WASM component" {
    class: optional
  }
}

scheduler: "Sync scheduler\nat most 5 runs at once" {
  top: 650
  left: 190
}

flush: "Write-queue flush\nthe only caller of Source::write" {
  class: write-box
  top: 650
  left: 590
}

db: Embedded PostgreSQL {
  top: 840
  left: 60
  grid-columns: 3
  mirror: "The mirror\na copy of every source's items"
  owned: "What only knobas has\nlinks, notes, time, link sets"
  queue: "The write queue\nwhat is still to send" {
    class: write-box
  }
}

app: The app {
  top: 1100
  left: 200
  grid-columns: 2
  window: "The window\nSvelte"
  commands: "Commands\nRust, knobas-app"
}

clones: "Your local clones\nread-only git" {
  top: 1160
  left: 780
}

sources -> adapters: sync
keychain -> adapters: credentials
adapters -> scheduler: items
scheduler -> db.mirror: upsert, tombstone

db.mirror -> app.commands: lists, search
db.owned <-> app.commands
app.window <-> app.commands
clones -> app.commands: "files, diffs"
app.commands -> adapters: "live reads\na pull request, a log, a file"

app.commands -> db.queue: every change {
  class: write
}
db.queue -> flush: due rows {
  class: write
}
flush -> adapters: write {
  class: write
}
adapters -> sources: "to the item's own source" {
  class: write
}
