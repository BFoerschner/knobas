# The README's system map. `just readme-diagrams` renders it in both themes.
#
# Amber is the only route that changes anything at a source. Each group is a grid
# column because TALA otherwise stacks the groups into a very tall picture.

direction: right

classes: {
  write: {
    style: {
      stroke: "#D97706"
      stroke-width: 2
      font-color: "#D97706"
    }
  }
  write-box: {
    style: {
      stroke: "#D97706"
      stroke-width: 2
    }
  }
  optional: {
    style.stroke-dash: 4
  }
  later: {
    style.stroke-dash: 4
  }
}

sources: Sources {
  grid-columns: 2
  jira: Jira Data Center
  confluence: Confluence Data Center
  gitea: Gitea or Forgejo
  teamcity: TeamCity
  kuma: Uptime Kuma
  other: Any other source {
    class: optional
  }
}

adapters: Adapters {
  grid-columns: 1
  builtin: "Built-in\none Rust crate per source"
  external: "External\na sandboxed WASM component" {
    class: optional
  }
}

keychain: OS keychain

background: Background work {
  grid-columns: 1
  scheduler: "Sync scheduler\nat most 5 runs at once"
  suggest: "Suggestion pass\none at a time"
  flush: "Write-queue flush\nthe only caller of Source::write" {
    class: write-box
  }
}

db: Embedded Postgres 18.6 {
  grid-columns: 1
  mirror: "sync: the mirror\nitems, revisions, parents"
  owned: "knobas: what no source owns\nlinks, notes, time, link sets"
  queue: "write_queue\nwhat is still to send" {
    class: write-box
  }
}

app: The app {
  grid-columns: 1
  search: "Search\nknobas-search"
  core: "Tauri commands\nknobas-app"
  window: "Svelte window\nand the capture window"
}

sources -> adapters: sync
keychain -> adapters: secrets
adapters -> background.scheduler: items
background.scheduler -> db.mirror: upsert, tombstone
background.scheduler -> background.suggest: run ended OK {
  class: later
}
background.suggest -> db.owned: proposes links

db.mirror -> app.search: reads
app.search -> app.core
db.owned <-> app.core: reads, writes
app.core <-> app.window
app.core -> adapters: "live reads: files, diffs, logs\nkept in memory"

app.core -> db.queue: submit_write {
  class: write
}
db.queue -> background.flush: due rows {
  class: write
}
background.flush -> adapters: write(op) {
  class: write
}
adapters -> sources: "to the item's own source" {
  class: write
}
