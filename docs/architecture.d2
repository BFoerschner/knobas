# knobas -- how the system actually couples together.
#
# Everything here is derived from the code, not from the plan documents:
#   merged   = on `main` (milestone M0, complete)
#   in flight = branch `m1/contract`, worktree .worktrees/m1-contract (NOT merged)
#   planned  = named in the roadmap, no code yet -- one dimmed node each
#
# The spine reads top to bottom and is the data path:
#   source system -> adapter -> [Source SPI] -> knobas-sync -> Postgres
#     -> search -> Tauri command -> [IPC boundary] -> Svelte UI
# The inset at the top right is the exact Cargo dependency graph.
#
# Render (dagre is d2's default layout; the flag is spelled out so a future
# run cannot drift onto another engine -- elk turns this graph into spaghetti):
#   d2 --layout dagre --pad 40 docs/architecture.d2 docs/architecture.svg
#
# The PNG is rasterised from that SVG rather than by d2 itself: `d2 ... .png`
# wants to download its own Chromium, and a browser is already on the machine.
#   printf '<body style="margin:0"><img src="architecture.svg" style="width:6879px">' > /tmp/w.html
#   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --headless \
#     --screenshot=docs/architecture.png --window-size=6879,4803 --hide-scrollbars file:///tmp/w.html
#
# The two renders are NOT equally reproducible, and nothing in CI regenerates
# either -- there is no `d2` reference in the justfile, scripts/ or the
# workflows, so a drift between this file and the renders is caught by nobody.
#
#   architecture.svg  reproduces byte-for-byte from the command above on d2
#                     v0.8.1-HEAD, and twice in a row from one source. Note
#                     that d2 derives the CSS class and font-family hash
#                     (`d2-<digits>`) from the *compiled* diagram -- editing
#                     these comments leaves it alone, but changing one label
#                     rewrites it at ~416 sites, so a one-word change shows up
#                     as a diff touching most of the file. Normalise that hash
#                     (`s/d2-[0-9]*/H/g`) before reading a render diff, or the
#                     real change is invisible in the noise.
#   architecture.png  does NOT reproduce. Chrome's text rasterisation moved
#                     between the version that made the committed file and
#                     Chrome 151: re-rendering the *identical* SVG changes
#                     0.62% of channel bytes (76% of them by +/-1) and the file
#                     size by ~10%. So a PNG regenerated for a small edit
#                     carries that unrelated churn with it.
#
# ADR-0003 (2026-08-28) edited the SPI bullet below and regenerated the SVG.
# The PNG was deliberately left at its older Chrome rendering rather than
# commit ~600 KB of antialiasing churn alongside a two-line text change. It is
# therefore one bullet out of date. Regenerate it with the command above when
# something is changing the PNG anyway.

# Palette: graphite + hairlines, amber reserved for the one thing that is
# moving (the in-flight branch). The page paints its own soft ground rather
# than inheriting the viewer's, so the SVG reads the same embedded in a light
# or a dark document -- an SVG cannot re-style explicit fills per colour scheme.

direction: down

style.fill: "#FAFAF9"

classes: {
  merged: {
    style: {
      fill: "#F1F1EF"
      stroke: "#5A5A62"
      stroke-width: 1
      font-color: "#232327"
      border-radius: 4
      font-size: 13
    }
  }
  flight: {
    style: {
      fill: "#FBF2DF"
      stroke: "#B4802A"
      stroke-width: 2
      font-color: "#4A3608"
      border-radius: 4
      font-size: 13
    }
  }
  planned: {
    style: {
      fill: "#F5F5F3"
      stroke: "#A9A9A3"
      stroke-width: 1
      stroke-dash: 4
      font-color: "#77777E"
      border-radius: 4
      font-size: 13
    }
  }
  seam: {
    style: {
      fill: "#E6E6E2"
      stroke: "#1F1F23"
      stroke-width: 3
      font-color: "#17171A"
      border-radius: 2
      bold: true
      font-size: 14
    }
  }
  store: {
    style: {
      fill: "#EAEDF0"
      stroke: "#4F5C67"
      stroke-width: 1
      font-color: "#1E252B"
      border-radius: 4
      font-size: 13
    }
  }
  seamband: {
    style: {
      fill: "#EFEFEB"
      stroke: "#1F1F23"
      stroke-width: 3
      font-color: "#17171A"
      border-radius: 3
      font-size: 15
      bold: true
    }
  }
  band: {
    style: {
      fill: "#F6F6F4"
      stroke: "#CFCFC9"
      stroke-width: 1
      font-color: "#3F3F46"
      border-radius: 6
      font-size: 15
    }
  }
  note: {
    style: {
      fill: "#FFFFFF"
      stroke: "#DCDBD5"
      stroke-width: 1
      font-color: "#3F3F46"
      border-radius: 4
      font-size: 12
    }
  }
  flow: {
    style: {
      stroke: "#2F2F35"
      stroke-width: 2
      font-color: "#2F2F35"
      font-size: 11
    }
  }
  dep: {
    style: {
      stroke: "#8B8B92"
      stroke-width: 1
      font-color: "#5C5C64"
      font-size: 11
    }
  }
  amberedge: {
    style: {
      stroke: "#B4802A"
      stroke-width: 2
      font-color: "#7A5615"
      font-size: 11
    }
  }
  ghostedge: {
    style: {
      stroke: "#AAAAA4"
      stroke-width: 1
      stroke-dash: 4
      font-color: "#8B8B92"
      font-size: 11
    }
