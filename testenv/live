#!/usr/bin/env bash
# Start and stop the real products the live suites run against, on this
# machine, one at a time (issue #633; live-lib.sh says why and how).
#
#   ./live up <product>     start it and what it needs, wait, seed it
#   ./live down <product>   stop it (TeamCity, Gitea) or remove it with its
#                           volumes (Jira, Confluence: 3-hour licences)
#   ./live status           one line per product
#
# <product> is gitea, forgejo (#1195), teamcity, jira or confluence. `up` of a JVM product
# waits for the machine-wide JVM lock a live run holds (issue #690), then
# refuses a second JVM product while one is up, naming it, and keeps the
# lock until `down` (#2121). `just live-up` /
# `just live-down` are these; the `just *-live` recipes do both around their
# suites themselves.
set -euo pipefail
# shellcheck source=testenv/live-lib.sh disable=SC1091
. "$(cd "$(dirname "$0")" && pwd)/live-lib.sh"

usage() { echo "usage: testenv/live up|down <gitea|forgejo|teamcity|jira|confluence> | status" >&2; exit 2; }

case "${1:-}" in
  up)
    [ $# -eq 2 ] || usage
    # A JVM product's start and seed take the JVM lock (issue #690), so a
    # hand `live-up teamcity` queues behind a live run instead of starting
    # under it; a keeper then holds it until `live down` (#2121).
    live_up_held "$2" ;;
  down) [ $# -eq 2 ] || usage; live_down "$2" ;;
  status)
    [ $# -eq 1 ] || usage
    for p in gitea forgejo teamcity jira confluence; do
      if live_is_up "$p"; then echo "$p: up"; else echo "$p: down"; fi
    done ;;
  *) usage ;;
esac
