# source testenv/hetzner/env
#
# Puts bin/ first on PATH so that `docker` calls naming one of the three remote
# products -- knobas-jira, jira-db, knobas-teamcity, confluence, ... -- go to
# that product's docker context, and every other call reaches the local engine
# untouched. The seed scripts then run against the Hetzner servers without a
# change; the on-demand live recipes refuse this shell since #633. See README.md.
export PATH="$(cd "$(dirname "${BASH_SOURCE:-$0}")" && pwd)/bin:$PATH"
# Since 2026-10-12 (#633) no live recipe uses the servers: they run the
# products locally, and testenv/live refuses a shell where this is set -- the
# shim above would otherwise send its container names to the servers. Until
# #633, `just atlassian-live` read this to start Jira and Confluence at once.
export KNOBAS_TESTENV_HETZNER=1
# Read by nothing since #633. Until then `just atlassian-live` read it to keep
# the pair up on its servers between runs instead of tearing it down.
export KNOBAS_ATLASSIAN_KEEP=1
