# Image digest pins for testenv/docker-compose.yml. Public digests only --
# no secrets live here. Regenerate with ./pin-images.sh, review the diff.
#
# Approximate pull cost, compressed, amd64 (why the big ones are opt-in
# profiles): gitea ~110 MB, uptime-kuma ~250 MB, node:22-alpine ~60 MB --
# the default `docker compose up` set, well under 1 GB. teamcity-server
# ~2.5 GB compressed and ~10 GB on disk once its data directory exists;
# jira-software ~700 MB; confluence ~800 MB.
#
# The two build stages of mockd.Dockerfile are pinned for the same reason
# the services are: an unpinned `rust:1-slim` makes the mockd container
# unreproducible. rust-toolchain.toml still decides the compiler --
# rustup inside the image obeys it -- so this pins the base OS, not rustc.
# rust:1-slim
RUST_IMAGE=rust@sha256:fb4b2f1dc68c06f46618948b09d0ade147e6d2b11a6581e599b0c808d5b8a167
# debian:trixie-slim
RUNTIME_IMAGE=debian@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132
#
# gitea/gitea:1
GITEA_IMAGE=gitea/gitea@sha256:d20286ca2b2e170fdf628e7231b8a31a3220ade39ff462b55041d43d1fc757dd
# louislam/uptime-kuma:2
KUMA_IMAGE=louislam/uptime-kuma@sha256:3e24e96c89efff0e3a4b0698cbdd36c15ad3022371db57166e5588853002ee5c
# node:22-alpine
NODE_IMAGE=node@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
# jetbrains/teamcity-server:latest
TEAMCITY_IMAGE=jetbrains/teamcity-server@sha256:30267c7f633a7973af1551e6f7f7683f49029ee81145b4710c570fd8393ccaef
# atlassian/jira-software:11.3.10
JIRA_IMAGE=atlassian/jira-software@sha256:23536987fc06637e3e516231ac59dfdeacda4f5fb22820a91eca6139714b01bd
# atlassian/confluence:10.2.15
CONFLUENCE_IMAGE=atlassian/confluence@sha256:810903b01662b85cd511f5e3c7dfc334b5c2850cf73b62503800aff5448983f6
